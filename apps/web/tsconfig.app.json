{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    /* `types` is an allow-list: once it is set, only these @types packages
       contribute globals. @types/google.maps has to be named here or the
       `google.maps` namespace is invisible even though it is installed. */
    "types": ["vite/client", "google.maps"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Path alias — kept in sync with resolve.alias in vite.config.ts.
       No `baseUrl`: TypeScript 6 deprecates it (TS5101) and resolves these
       patterns relative to this file, which is what we want anyway. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
