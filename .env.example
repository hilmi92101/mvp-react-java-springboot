# Copy to .env and edit. Every value here has a default in docker-compose.yml,
# so an empty .env still boots -- this file exists to document the knobs and to
# be the one place a port collision gets fixed.

# Ports as seen from the host.
WEB_PORT=5173
API_PORT=8080
DB_PORT=1433
DBUI_PORT=8978

# SQL Server's password rules are enforced by the container at startup, not at
# first login: at least 8 characters with three of {uppercase, lowercase,
# digit, symbol}. A weaker value makes the container print a password-policy
# error and exit 1, which is easy to mistake for a crash.
MSSQL_SA_PASSWORD=Local_Dev_Pass123
MSSQL_DB=TESTDB

# Where the browser reaches each side. Both are host URLs, not service names.
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080

# Paired with -XX:MaxRAMPercentage=75 in compose. A container without a limit
# lets the JVM size its heap against the host's total RAM and get OOM-killed.
API_MEM_LIMIT=3g

# SQL Server refuses to start below ~2GB. This is a floor, not a tuning knob.
# Together with API_MEM_LIMIT this stack wants ~5GB available.
DB_MEM_LIMIT=2g

# Google Maps / Places browser key, used by the Place Finder app at
# /apps/place-finder. A VITE_ variable is compiled into the bundle, so this
# value IS public -- restrict the key instead of hiding it:
#   Application restriction -> HTTP referrers -> http://localhost:5173/*
#   API restriction         -> Maps JavaScript API + Places API (New)
# Both of those APIs must be enabled, and the project needs a billing account
# linked even though normal dev usage stays inside the free monthly allowance.
VITE_GOOGLE_MAPS_API_KEY=

# Server-side Google Places key, used by /api/places/search and
# /api/places/details/{id}. Deliberately no VITE_ prefix -- Vite only inlines
# VITE_* variables, so this one never reaches the browser bundle.
#
# It cannot be the same key as VITE_GOOGLE_MAPS_API_KEY if that key is
# HTTP-referrer restricted: a server sends no referrer and Google answers
# REQUEST_DENIED. Use a second key restricted by IP (or unrestricted, local
# development only), with the Places API (New) enabled.
#
# Empty is a supported state: /api/places/search then answers 503 saying so.
GOOGLE_PLACES_API_KEY=
